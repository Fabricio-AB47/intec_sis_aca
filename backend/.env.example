# INTEGRATION_CONTROL_DB_PASSWORD=
# INTEGRATION_CONTROL_DB_HOST=
# INTEGRATION_CONTROL_DB_PORT=1433

TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_MAIL_SENDER=
GRAPH_SCOPE=
GRAPH_DELEGATE_SCOPES=
GRAPH_DELEGATE_REDIRECT_URI=
FRONTEND_BASE_URL=

# Alias también aceptados para Microsoft Graph:
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_SENDER_EMAIL=
# MS_SENDER_USER_ID=
# SENDER_EMAIL=
# SENDER_USER_ID=

SESSION_SECRET=
SESSION_COOKIE_NAME=reporteria_session
SESSION_EXPIRE_MINUTES=480
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

AUTH_LEGACY_PLAINTEXT_ENABLED=true
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOWED_HEADERS=Accept,Accept-Language,Authorization,Content-Language,Content-Type,If-Modified-Since,If-None-Match,Range,X-Evaluation-Token,X-Request-ID,X-Requested-With

# Moodle: fase de consulta exclusivamente de lectura.
MOODLE_BASE_URL=https://aulasintec.ec
MOODLE_ADMIN_TOKEN=
MOODLE_ENABLED=false
MOODLE_READS_ENABLED=true
MOODLE_WRITES_ENABLED=false
MOODLE_USER_STATUS_UPDATE_ENABLED=false
MOODLE_SECTION_UPDATES_ENABLED=false
MOODLE_TIMEOUT_SECONDS=60
MOODLE_VERIFY_TLS=true
MOODLE_CACHE_TTL_SECONDS=120
MOODLE_FULL_USER_SCAN_ENABLED=false
MOODLE_MAX_USER_SCAN_ITEMS=20000
MOODLE_GRADE_SYNC_ENABLED=true
MOODLE_GRADE_SYNC_APPLY_ENABLED=false
MOODLE_GRADE_SYNC_NIGHTLY_ENABLED=false
MOODLE_GRADE_SYNC_CHANGES_ENABLED=false
MOODLE_GRADE_SYNC_INTERVAL_MINUTES=5
# Correspondencias Moodle:INTECBDD separadas por coma. Ejemplo: 51:1051,72:1056
MOODLE_GRADE_SYNC_MAPPINGS=
MOODLE_GRADE_SYNC_LOCK_TIMEOUT_MS=5000
