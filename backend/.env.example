DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_DRIVER=
DB_ENCRYPT=yes
DB_TRUST_CERT=

# Seguridad de aplicación. En producción, el arranque se bloquea si alguna
# de estas protecciones queda deshabilitada o usa valores inseguros.
APP_ENVIRONMENT=development
API_DOCS_ENABLED=true
EXPOSE_INTERNAL_ERRORS=false
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=false
CSRF_PROTECTION_ENABLED=true
CSRF_REQUIRE_ORIGIN=false
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MAX_REQUEST_BODY_BYTES=2200000000
JWT_ISSUER=intec-sis-aca
JWT_AUDIENCE=intec-sis-aca-web
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900
EVALUATION_LOOKUP_RATE_LIMIT=30
# Use memory solo en desarrollo. Producción exige Redis compartido.
RATE_LIMIT_BACKEND=memory
# Ejemplo: rediss://usuario:clave@redis.interno:6380/0
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_PREFIX=sisaca
SESSION_REVOCATION_ENABLED=true
RESPONSE_GZIP_ENABLED=true
RESPONSE_GZIP_MINIMUM_SIZE=1024

# ClamAV por protocolo INSTREAM. Producción exige habilitarlo; cada adjunto
# leído por la API se analiza antes de su almacenamiento o procesamiento.
UPLOAD_ANTIMALWARE_ENABLED=false
UPLOAD_ANTIMALWARE_HOST=127.0.0.1
UPLOAD_ANTIMALWARE_PORT=3310
UPLOAD_ANTIMALWARE_TIMEOUT_SECONDS=15
CREDENTIAL_PROVISION_CONCURRENCY=5

B_NAME3=TITULACION_INTEC
DB_USER3=
DB_PASSWORD3=
DB_HOST3=
DB_PORT3=1433
DB_DRIVER3=
DB_TRUST_CERT3=

# Bases complementarias. Las credenciales son opcionales y heredan DB_USER1/DB_HOST1.
EXPEDIENT_DB_NAME=INTEC_EXPEDIENTE_ESTUDIANTIL
# EXPEDIENT_DB_USER=
# EXPEDIENT_DB_PASSWORD=
# EXPEDIENT_DB_HOST=
# EXPEDIENT_DB_PORT=1433

FINANCE_DB_NAME=INTEC_FINANZAS_INSTITUCIONAL
# FINANCE_DB_USER=
# FINANCE_DB_PASSWORD=
# FINANCE_DB_HOST=
# FINANCE_DB_PORT=1433

GRAPH_DB_NAME=INTEC_GRAPH_INTEGRACION
# GRAPH_DB_USER=
# GRAPH_DB_PASSWORD=
# GRAPH_DB_HOST=
# GRAPH_DB_PORT=1433

INTEGRATION_CONTROL_DB_NAME=INTEC_INTEGRACION_CONTROL
# INTEGRATION_CONTROL_DB_USER=
# INTEGRATION_CONTROL_DB_PASSWORD=
# INTEGRATION_CONTROL_DB_HOST=
# INTEGRATION_CONTROL_DB_PORT=1433

TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_MAIL_SENDER=
GRAPH_SCOPE=
GRAPH_USER_DOMAIN=intec.edu.ec
# Licencia educativa aplicada exclusivamente a las identidades estudiantiles.
GRAPH_STUDENT_LICENSE_SKU_PART_NUMBER=STANDARDWOFFPACK_STUDENT
# Fijación opcional del GUID del mismo SKU estudiantil; nunca use un SKU docente.
GRAPH_STUDENT_LICENSE_SKU_ID=
# Licencia educativa aplicada exclusivamente desde el apartado Profesores.
GRAPH_FACULTY_LICENSE_SKU_PART_NUMBER=STANDARDWOFFPACK_FACULTY
# Fijación opcional del GUID del mismo SKU docente; nunca use un SKU estudiantil.
GRAPH_FACULTY_LICENSE_SKU_ID=
GRAPH_USER_USAGE_LOCATION=EC
GRAPH_DELEGATE_SCOPES=
GRAPH_DELEGATE_REDIRECT_URI=
FRONTEND_BASE_URL=

# Alias también aceptados para Microsoft Graph:
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_SENDER_EMAIL=
# MS_SENDER_USER_ID=
# SENDER_EMAIL=
# SENDER_USER_ID=

SESSION_SECRET=
# Secreto estable y exclusivo para cifrar las contraseñas recuperables del histórico.
# En desarrollo puede omitirse y se derivará de SESSION_SECRET; en producción defínalo.
CREDENTIAL_ARCHIVE_SECRET=
SESSION_COOKIE_NAME=reporteria_session
SESSION_EXPIRE_MINUTES=480
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

AUTH_LEGACY_PLAINTEXT_ENABLED=true
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOWED_HEADERS=Accept,Accept-Language,Authorization,Content-Language,Content-Type,If-Modified-Since,If-None-Match,Range,X-Evaluation-Token,X-Request-ID,X-Requested-With

# Moodle: fase de consulta exclusivamente de lectura.
MOODLE_BASE_URL=https://aulasintec.ec
MOODLE_ADMIN_TOKEN=
MOODLE_ENABLED=false
MOODLE_READS_ENABLED=true
MOODLE_WRITES_ENABLED=false
MOODLE_USER_STATUS_UPDATE_ENABLED=false
MOODLE_SECTION_UPDATES_ENABLED=false
MOODLE_EVALUATION_DATES_UPDATE_ENABLED=false
MOODLE_EVALUATION_DATES_FUNCTION=local_sisaca_bulk_update_evaluation_dates
MOODLE_TIMEOUT_SECONDS=60
MOODLE_VERIFY_TLS=true
MOODLE_CACHE_TTL_SECONDS=120
MOODLE_FULL_USER_SCAN_ENABLED=false
MOODLE_MAX_USER_SCAN_ITEMS=20000
MOODLE_GRADE_SYNC_ENABLED=true
MOODLE_GRADE_SYNC_APPLY_ENABLED=false
MOODLE_GRADE_SYNC_NIGHTLY_ENABLED=false
MOODLE_GRADE_SYNC_CHANGES_ENABLED=false
MOODLE_GRADE_SYNC_INTERVAL_MINUTES=5
# Correspondencias Moodle:INTECBDD separadas por coma. Ejemplo: 51:1051,72:1056
MOODLE_GRADE_SYNC_MAPPINGS=
MOODLE_GRADE_SYNC_LOCK_TIMEOUT_MS=5000
